---
import { getExperience } from '../../data/experience';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const experience = getExperience(lang as 'es' | 'en');
---

<div class="experience-timeline relative space-y-10">
  <div class="timeline-line absolute left-0 top-2 bottom-2 w-0.5 bg-gray-200 dark:bg-gray-700 origin-top" aria-hidden="true"></div>
  {experience.map((exp) => (
    <div class="timeline-item relative pl-8">
      <div class="timeline-dot absolute -left-[7px] top-1.5 w-4 h-4 rounded-full bg-primary border-2 border-white dark:border-gray-900"></div>
      <div class="timeline-card transition-[translate] duration-300 hover:translate-x-1">
        <div class="mb-1 flex flex-wrap items-center gap-x-2 gap-y-1">
          <span class="text-sm text-gray-500 dark:text-gray-400">{exp.period}</span>
          {exp.location && (
            <span class="text-xs text-gray-400 dark:text-gray-500">• {exp.location}</span>
          )}
          {exp.contract && (
            <span class="rounded-full border border-sky-200 bg-sky-50 px-2 py-0.5 text-[11px] font-medium text-sky-700 dark:border-sky-800 dark:bg-sky-900/30 dark:text-sky-300">{exp.contract}</span>
          )}
        </div>
        <h4 class="text-lg font-semibold text-black dark:text-white">{exp.role}</h4>
        <p class="text-primary font-medium mb-2">{exp.company}</p>
        <p class="text-gray-600 dark:text-gray-300 text-sm mb-3">{exp.description}</p>
        <div class="flex flex-wrap gap-2">
          {exp.tags.map((tag) => (
            <span class="timeline-tag text-xs px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded-full text-gray-600 dark:text-gray-400">
              {tag}
            </span>
          ))}
        </div>
      </div>
    </div>
  ))}
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector<HTMLElement>('.experience-timeline');

  if (root && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const line = root.querySelector('.timeline-line');

    // The line draws itself as the user scrolls through the section.
    const items = Array.from(root.querySelectorAll<HTMLElement>('.timeline-item'));
    const lineInset = 8; // matches top-2 / bottom-2 on the line

    // A dot lights up once the drawn line reaches its centre.
    const updateLitDots = (progress: number) => {
      const drawn = lineInset + progress * (root.offsetHeight - lineInset * 2);
      items.forEach((item) => {
        const dot = item.querySelector('.timeline-dot');
        const dotCenter = item.offsetTop + (dot as HTMLElement).offsetTop + (dot as HTMLElement).offsetHeight / 2;
        dot?.classList.toggle('is-lit', dotCenter <= drawn);
      });
    };

    gsap.fromTo(
      line,
      { scaleY: 0 },
      {
        scaleY: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: root,
          start: 'top 80%',
          end: 'bottom 60%',
          scrub: true,
          onUpdate: (self) => updateLitDots(self.progress),
          onRefresh: (self) => updateLitDots(self.progress),
        },
      },
    );

    items.forEach((item) => {
      const tl = gsap.timeline({
        scrollTrigger: { trigger: item, start: 'top 85%', toggleActions: 'play none none none' },
      });

      tl.from(item.querySelector('.timeline-dot'), { scale: 0, duration: 0.4, ease: 'back.out(3)' })
        .from(item.querySelector('.timeline-card'), { opacity: 0, x: -30, duration: 0.6, ease: 'power3.out' }, '-=0.15')
        .from(item.querySelectorAll('.timeline-tag'), { opacity: 0, y: 8, stagger: 0.05, duration: 0.3, ease: 'power2.out' }, '-=0.3');
    });
  }
</script>

<style>
  .timeline-dot {
    transition: box-shadow 0.3s ease;
  }
  .timeline-item:hover .timeline-dot,
  .timeline-dot.is-lit {
    box-shadow: 0 0 0 6px rgba(14, 165, 233, 0.2);
  }
</style>
