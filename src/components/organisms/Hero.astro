---
import { useTranslations } from '../../i18n/utils';
import Badge from '../atoms/Badge.astro';
import SocialLink from '../molecules/SocialLink.astro';
import Linkedin from '../../icons/Linkedin.astro';
import Github from '../../icons/Github.astro';
import Mail from '../../icons/Mail.astro';
import Download from '../../icons/Download.astro';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang as 'es' | 'en');

const socialLinks = [
  { href: 'https://www.linkedin.com/in/josemavsg', label: 'LinkedIn', icon: Linkedin },
  { href: 'https://github.com/JosemAVSG', label: 'GitHub', icon: Github },
  { href: 'mailto:jmgg.95n@gmail.com', label: 'Email', icon: Mail },
];
---

<div class="max-w-6xl">
  <div class="flex flex-wrap items-center gap-4 mb-4">
    <img 
      class="w-24 h-24 rounded-2xl shadow-lg border-2 border-primary/20" 
      src="https://avatars.githubusercontent.com/u/107879363?s=400&u=37610b02b2a4947fc2cf337710d5e6986a40f695&v=4" 
      alt="Jose Miguel González" 
    />
    <div>
      <a
        href="https://www.linkedin.com/in/josemavsg"
        target="_blank"
        rel="noopener"
      >
        <Badge>Open to Work</Badge>
      </a>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Colombia, Cali</p>
    </div>
  </div>

  <!-- Decorative multilingual greeting carousel (pure CSS, aria-hidden; the
       localized h1 below remains the real heading for SEO/a11y) -->
  <div class="greeting-carousel flex items-center gap-3 h-10 md:h-12" aria-hidden="true">
    <span class="text-3xl md:text-4xl leading-none">👋</span>
    <div class="relative inline-block h-10 leading-10 md:h-12 md:leading-[3rem]">
      <span class="greeting-word greeting-word-0"><span class="shimmer-text bg-[length:200%_100%] bg-gradient-to-r from-neutral-950 via-neutral-400 to-neutral-950 dark:from-white dark:via-neutral-600 dark:to-white bg-clip-text text-transparent">Hello</span></span>
      <span class="greeting-word greeting-word-1"><span class="shimmer-text bg-[length:200%_100%] bg-gradient-to-r from-neutral-950 via-neutral-400 to-neutral-950 dark:from-white dark:via-neutral-600 dark:to-white bg-clip-text text-transparent">こんにちは</span></span>
      <span class="greeting-word greeting-word-2"><span class="shimmer-text bg-[length:200%_100%] bg-gradient-to-r from-neutral-950 via-neutral-400 to-neutral-950 dark:from-white dark:via-neutral-600 dark:to-white bg-clip-text text-transparent">Bonjour</span></span>
      <span class="greeting-word greeting-word-4"><span class="shimmer-text bg-[length:200%_100%] bg-gradient-to-r from-neutral-950 via-neutral-400 to-neutral-950 dark:from-white dark:via-neutral-600 dark:to-white bg-clip-text text-transparent">안녕하세요</span></span>
      <span class="greeting-word greeting-word-5"><span class="shimmer-text bg-[length:200%_100%] bg-gradient-to-r from-neutral-950 via-neutral-400 to-neutral-950 dark:from-white dark:via-neutral-600 dark:to-white bg-clip-text text-transparent">Ciao</span></span>
      <span class="greeting-word greeting-word-6"><span class="shimmer-text bg-[length:200%_100%] bg-gradient-to-r from-neutral-950 via-neutral-400 to-neutral-950 dark:from-white dark:via-neutral-600 dark:to-white bg-clip-text text-transparent">Hallo</span></span>
      <span class="greeting-word greeting-word-7"><span class="shimmer-text bg-[length:200%_100%] bg-gradient-to-r from-neutral-950 via-neutral-400 to-neutral-950 dark:from-white dark:via-neutral-600 dark:to-white bg-clip-text text-transparent">{t('hero.greetingFinal')}</span></span>
    </div>
  </div>

  <h1 class="shimmer-text mb-4 bg-[length:200%_100%] bg-gradient-to-r from-neutral-950 via-neutral-400 to-neutral-950 dark:from-white dark:via-neutral-600 dark:to-white bg-clip-text text-transparent text-4xl md:text-5xl font-bold">
    {t('hero.title')}
  </h1>

  <h2 class="text-xl md:text-2xl text-gray-600 dark:text-gray-300 mb-6 leading-relaxed">
    {t('hero.subtitle')}
  </h2>
<div class="flex flex-row justify-between items-center">

  <ul class="flex flex-wrap gap-4 list-none p-0 m-0">
    {socialLinks.map((link) => (
      <SocialLink {...link} />
    ))}
  </ul>

  <a
    href="/cv.pdf"
    download
    class="mt-6 inline-flex items-center gap-2 rounded-xl border border-gray-600 bg-gray-800 px-4 py-2 text-sm font-medium text-white transition hover:bg-gray-900 hover:border-gray-700 active:bg-black"
  >
    <Download class="size-4" />
    {t('hero.downloadCv')}
  </a>
</div>

  <!-- Quick Stats -->
  <div class="flex flex-wrap gap-6 mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
    <div>
      <span class="text-2xl font-bold text-primary">+4</span>
      <span class="text-sm text-gray-500 dark:text-gray-400 ml-1">years</span>
    </div>
    <div>
      <span class="text-2xl font-bold text-primary">AWS</span>
      <span class="text-sm text-gray-500 dark:text-gray-400 ml-1">Certified</span>
    </div>
  </div>
</div>

<style>
  /* --- Shimmer text (KokonutUI visual port, pure CSS) --- */
  .shimmer-text {
    -webkit-text-fill-color: transparent;
    background-position: 200% center;
    animation: shimmer 6s linear infinite;
  }

  @keyframes shimmer {
    from {
      background-position: 200% center;
    }
    to {
      background-position: -200% center;
    }
  }

  /* --- Greeting carousel (KokonutUI dynamic-text visual port, pure CSS) --- */
  .greeting-word {
    position: absolute;
    top: 0;
    left: 0;
    width: max-content;
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 2.5rem;
    color: #4b5563;
    opacity: 0;
  }

  /* Match the h1 scale (md:text-5xl) on larger screens */
  @media (min-width: 768px) {
    .greeting-word {
      font-size: 3rem;
      line-height: 3rem;
    }
  }

  /* 8 words, 12.5% slot each over a 4.8s cycle; each word fades in,
     holds briefly, then exits. The last word ends STATIC (stays visible). */
  @keyframes greet-0 {
    0% { opacity: 0; transform: translateY(0.9em); }
    2% { opacity: 1; transform: translateY(0); }
    10% { opacity: 1; transform: translateY(0); }
    12% { opacity: 0; transform: translateY(-0.9em); }
    100% { opacity: 0; }
  }
  @keyframes greet-1 {
    0% { opacity: 0; transform: translateY(0.9em); }
    12.5% { opacity: 0; }
    14.5% { opacity: 1; transform: translateY(0); }
    22.5% { opacity: 1; transform: translateY(0); }
    24.5% { opacity: 0; transform: translateY(-0.9em); }
    100% { opacity: 0; }
  }
  @keyframes greet-2 {
    0% { opacity: 0; transform: translateY(0.9em); }
    25% { opacity: 0; }
    27% { opacity: 1; transform: translateY(0); }
    35% { opacity: 1; transform: translateY(0); }
    37% { opacity: 0; transform: translateY(-0.9em); }
    100% { opacity: 0; }
  }
  @keyframes greet-3 {
    0% { opacity: 0; transform: translateY(0.9em); }
    37.5% { opacity: 0; }
    39.5% { opacity: 1; transform: translateY(0); }
    47.5% { opacity: 1; transform: translateY(0); }
    49.5% { opacity: 0; transform: translateY(-0.9em); }
    100% { opacity: 0; }
  }
  @keyframes greet-4 {
    0% { opacity: 0; transform: translateY(0.9em); }
    50% { opacity: 0; }
    52% { opacity: 1; transform: translateY(0); }
    60% { opacity: 1; transform: translateY(0); }
    62% { opacity: 0; transform: translateY(-0.9em); }
    100% { opacity: 0; }
  }
  @keyframes greet-5 {
    0% { opacity: 0; transform: translateY(0.9em); }
    62.5% { opacity: 0; }
    64.5% { opacity: 1; transform: translateY(0); }
    72.5% { opacity: 1; transform: translateY(0); }
    74.5% { opacity: 0; transform: translateY(-0.9em); }
    100% { opacity: 0; }
  }
  @keyframes greet-6 {
    0% { opacity: 0; transform: translateY(0.9em); }
    75% { opacity: 0; }
    77% { opacity: 1; transform: translateY(0); }
    85% { opacity: 1; transform: translateY(0); }
    87% { opacity: 0; transform: translateY(-0.9em); }
    100% { opacity: 0; }
  }
  @keyframes greet-7 {
    0% { opacity: 0; transform: translateY(0.9em); }
    87.5% { opacity: 0; }
    89.5% { opacity: 1; transform: translateY(0); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .greeting-word-0 { animation: greet-0 4.8s linear both; }
  .greeting-word-1 { animation: greet-1 4.8s linear both; }
  .greeting-word-2 { animation: greet-2 4.8s linear both; }
  .greeting-word-3 { animation: greet-3 4.8s linear both; }
  .greeting-word-4 { animation: greet-4 4.8s linear both; }
  .greeting-word-5 { animation: greet-5 4.8s linear both; }
  .greeting-word-6 { animation: greet-6 4.8s linear both; }
  .greeting-word-7 { animation: greet-7 4.8s linear both; }

  /* --- Reduced motion: freeze shimmer, show only the final greeting --- */
  @media (prefers-reduced-motion: reduce) {
    .shimmer-text {
      animation: none;
      background-position: 200% center;
    }

    .greeting-word {
      animation: none;
      opacity: 0;
    }

    .greeting-word:last-child {
      opacity: 1;
    }
  }
</style>