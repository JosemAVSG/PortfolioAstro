---
import { useTranslations } from '../../i18n/utils';
import { getProjects } from '../../data/projects';
import ProjectCard from '../molecules/ProjectCard.astro';
import ImageLightbox from '../molecules/ImageLightbox.astro';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang as 'es' | 'en');
const projects = getProjects(lang as 'es' | 'en');

const categories = [
  { key: 'products', label: t('projects.products') },
  { key: 'devops', label: t('projects.devops') },
];

const sections = Object.entries(projects).map(([category, items]) => ({
  category,
  featured: items.filter((p) => p.featured).sort((a, b) => a.featured! - b.featured!),
  rest: items.filter((p) => !p.featured),
}));

const cardLabels = {
  codeLabel: t('projects.code'),
  demoLabel: t('projects.preview'),
  photosLabel: t('projects.photos'),
  withLabel: t('projects.with'),
};
---

<div id="projects-section">
  <!-- Tabs -->
  <div class="flex flex-wrap gap-2 mb-8">
    {categories.map((cat, index) => (
      <button
        class={`tab-btn px-5 py-2.5 rounded-full text-sm font-semibold transition-all duration-300 ${
          index === 0
            ? 'bg-sky-600 text-white shadow-md hover:bg-sky-700'
            : 'bg-white dark:bg-gray-800 text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white'
        }`}
        data-category={cat.key}
      >
        {cat.label}
      </button>
    ))}
  </div>

  <!-- Project lists: featured (large) first, then the rest in a grid -->
  <div>
    {sections.map(({ category, featured, rest }, index) => (
      <div class="project-category space-y-8" data-category={category} style={index === 0 ? undefined : 'display: none'}>
        {featured.length > 0 && (
          <div class="space-y-6">
            {featured.map((item, i) => (
              <ProjectCard {...item} {...cardLabels} index={i} featured reverse={i % 2 === 1} />
            ))}
          </div>
        )}

        {rest.length > 0 && (
          <div>
            {featured.length > 0 && (
              <h3 class="mb-4 font-medium text-lg md:text-xl tracking-tight text-gray-900 dark:text-white">
                {t('projects.more')}
              </h3>
            )}
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {rest.map((item, i) => (
                <ProjectCard {...item} {...cardLabels} index={i} featured={false} />
              ))}
            </div>
          </div>
        )}
      </div>
    ))}
  </div>
  <ImageLightbox />
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const tabs = document.querySelectorAll('.tab-btn');
  const categories = document.querySelectorAll<HTMLElement>('.project-category');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const ACTIVE = ['bg-sky-600', 'text-white', 'shadow-md', 'hover:bg-sky-700'];
  const INACTIVE = ['bg-white', 'dark:bg-gray-800', 'text-gray-600', 'dark:text-gray-400', 'border', 'border-gray-200', 'dark:border-gray-700', 'hover:bg-gray-50', 'dark:hover:bg-gray-700', 'hover:text-gray-900', 'dark:hover:text-white'];

  // Cards fade up as they enter the viewport, staggered within each batch.
  if (!reduceMotion) {
    const cards = gsap.utils.toArray<HTMLElement>('.project-card');
    gsap.set(cards, { opacity: 0, y: 28 });
    ScrollTrigger.batch(cards, {
      start: 'top 90%',
      once: true,
      onEnter: (batch) =>
        gsap.to(batch, { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out', stagger: 0.08, overwrite: true }),
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const category = tab.getAttribute('data-category');

      tabs.forEach((t) => {
        t.classList.remove(...ACTIVE);
        t.classList.add(...INACTIVE);
      });
      tab.classList.add(...ACTIVE);
      tab.classList.remove(...INACTIVE);

      categories.forEach((cat) => {
        cat.style.display = cat.getAttribute('data-category') === category ? 'block' : 'none';
      });

      const shown = document.querySelectorAll<HTMLElement>(`.project-category[data-category="${category}"] .project-card`);
      if (!reduceMotion) {
        gsap.fromTo(
          shown,
          { opacity: 0, y: 24 },
          { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out', stagger: 0.07, overwrite: true },
        );
      }
      ScrollTrigger.refresh();
    });
  });
</script>
