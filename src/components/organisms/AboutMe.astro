---
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang as 'es' | 'en');

const avatarUrl = 'https://avatars.githubusercontent.com/u/107879363?s=400&u=37610b02b2a4947fc2cf337710d5e6986a40f695&v=4';

const bio = [
  t('about.bio1'),
  t('about.bio2'),
  t('about.bio3'),
];

const skills = lang === 'es' 
  ? ['React', 'Next.js', 'TypeScript', 'JavaScript', 'Node.js', 'NestJS', 'Express', 'Zustand', 'Redux', 'PostgreSQL', 'MongoDB', 'MySQL', 'AWS', 'Docker', 'Terraform']
  : ['React', 'Next.js', 'TypeScript', 'JavaScript', 'Node.js', 'NestJS', 'Express', 'Zustand', 'Redux', 'PostgreSQL', 'MongoDB', 'MySQL', 'AWS', 'Docker', 'Terraform'];
---

<section class="space-y-8">
  <div class="flex flex-col md:flex-row gap-8 items-start">
    <div class="hero-img shrink-0">
      <div class="circulo"></div>
      <img width="200" height="200" src={avatarUrl} alt="Jose Miguel González"
        class="order-1 object-cover w-48 h-48 md:w-56 md:h-56 p-2 rounded-2xl bg-black/20 dark:bg-yellow-500/5 ring-2 ring-primary/20" />
    </div>
    <div class="flex-1 space-y-4">
      {bio.map((paragraph) => (
        <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed" set:html={paragraph} />
      ))}
    </div>
  </div>

  <!-- Tech Stack -->
  <div class="pt-4">
    <h4 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-4">
      {lang === 'es' ? 'Tech Stack' : 'Tech Stack'}
    </h4>
    <div class="skill-pills flex gap-3">
      {skills.map((skill) => (
        <span class="skill-pill flex-1 text-center px-3 py-1.5 bg-white shadow-sm dark:bg-gray-800 text-gray-700 dark:text-gray-300 text-sm rounded-full font-medium hover:bg-primary/10 hover:text-primary">
          {skill}
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  /* Balanced pill rows: flex-wrap: balance distributes the pills so every
     line has a similar number of items (no orphan pill on the last line).
     New CSS (2026) — the plain `wrap` declaration before it is the fallback
     for browsers that don't support the `balance` keyword yet. */
  .skill-pills {
    flex-wrap: wrap;
    flex-wrap: wrap balance;
  }

  /* Pills: full-width (flex-1) chips that glow on hover. No magnetic motion. */
  .skill-pill {
    cursor: default;
    transition: box-shadow 0.25s ease, background-color 0.25s ease;
  }

  .skill-pill:hover {
    box-shadow:
      0 0 0 1px rgba(14, 165, 233, 0.45),
      0 4px 16px -4px rgba(14, 165, 233, 0.5);
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-pill {
      transition: none;
    }
  }

  .hero-img {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }
  .circulo {
    position: absolute;
    width: 180px;
    height: 180px;
    border: 3px #f9f871;
    border-radius: 50%;
    animation: rotate-center 6s linear infinite;
  }
  @keyframes rotate-center {
    0% { transform: rotate(0); }
    100% { transform: rotate(360deg); }
  }
  @media (max-width: 768px) {
    .circulo { width: 140px; height: 140px; }
  }
</style>