---
import type { ButtonProps } from '../../types';

interface Props extends ButtonProps {}

const { href, variant = 'primary', target, rel, class: className } = Astro.props;

const baseClasses =
  'inline-flex items-center justify-center gap-2 px-3 py-2 text-base transition border rounded-xl group max-w-fit focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-yellow-500/80 focus-visible:ring-offset-2';

const variantClasses = {
  primary: 'bg-gray-800 border-gray-600 text-white hover:bg-gray-900 hover:border-gray-700 active:bg-black',
  secondary: 'bg-transparent border-gray-600 text-gray-800 hover:bg-gray-100 hover:text-gray-900 hover:border-gray-700 active:bg-gray-200 dark:text-white dark:hover:bg-gray-800 dark:hover:text-white dark:active:bg-gray-700',
};
---

<a
  href={href}
  role="link"
  target={target}
  rel={rel}
  class:list={[baseClasses, variantClasses[variant], className]}
>
  <slot />
</a>