---
interface Props {
  title?: string;
}

const { title = 'Image gallery' } = Astro.props;
const galleryId = 'lightbox';
const galleryImgId = 'lightbox-img';
const galleryPrevId = 'lightbox-prev';
const galleryNextId = 'lightbox-next';
const galleryDotsId = 'lightbox-dots';
---

<div id={galleryId} hidden role="dialog" aria-modal="true" aria-label={title} class="fixed inset-0 z-50 items-center justify-center bg-black/80 backdrop-blur-sm">
  <button
    type="button"
    id="lightbox-close"
    aria-label="Close"
    class="absolute top-4 right-4 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/25 focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <button
    type="button"
    id={galleryPrevId}
    aria-label="Previous image"
    class="absolute left-4 top-1/2 z-10 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/25 focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
  </button>

  <button
    type="button"
    id={galleryNextId}
    aria-label="Next image"
    class="absolute right-4 top-1/2 z-10 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/25 focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <figure class="flex max-h-[80vh] max-w-[90vw] flex-col items-center gap-4">
    <img
      id={galleryImgId}
      alt=""
      class="max-h-[80vh] max-w-[90vw] rounded-lg object-contain"
    />
    <div id={galleryDotsId} class="flex items-center gap-2" aria-label="Image navigation"></div>
  </figure>
</div>

<script>
  const gallery = document.getElementById('lightbox') as HTMLElement;
  const galleryImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn = document.getElementById('lightbox-close') as HTMLButtonElement;
  const prevBtn = document.getElementById('lightbox-prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('lightbox-next') as HTMLButtonElement;
  const dotsContainer = document.getElementById('lightbox-dots') as HTMLDivElement;

  let images: string[] = [];
  let current = 0;
  let lastFocused: HTMLElement | null = null;

  const parseImages = (raw: string | null): string[] => {
    if (!raw) return [];
    try {
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed) ? parsed.filter((item): item is string => typeof item === 'string') : [];
    } catch {
      return [];
    }
  };

  const clamp = (index: number): number => {
    if (images.length === 0) return 0;
    return ((index % images.length) + images.length) % images.length;
  };

  const render = (): void => {
    if (!galleryImg || images.length === 0) return;
    galleryImg.src = images[current];
    galleryImg.alt = `Screenshot ${current + 1} of ${images.length}`;

    const hasMultiple = images.length > 1;
    const toggle = (element: HTMLElement | null, show: boolean): void => {
      if (!element) return;
      element.classList.toggle('hidden', !show);
      element.classList.toggle('flex', show);
    };
    toggle(prevBtn, hasMultiple);
    toggle(nextBtn, hasMultiple);

    if (dotsContainer) {
      dotsContainer.innerHTML = '';
      if (!hasMultiple) return;
      images.forEach((_, dotIndex) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'h-2.5 w-2.5 rounded-full bg-white/40 transition hover:bg-white/70 focus:outline-none focus-visible:ring-2 focus-visible:ring-white';
        if (dotIndex === current) dot.classList.add('bg-white');
        dot.setAttribute('aria-label', `Go to image ${dotIndex + 1}`);
        dot.setAttribute('aria-current', dotIndex === current ? 'true' : 'false');
        dot.addEventListener('click', () => {
          current = dotIndex;
          render();
        });
        dotsContainer.appendChild(dot);
      });
    }
  };

  const show = (): void => {
    if (!gallery) return;
    lastFocused = document.activeElement as HTMLElement;
    gallery.hidden = false;
    gallery.classList.add('flex');
    gallery.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    render();
  };

  const hide = (): void => {
    if (!gallery) return;
    gallery.hidden = true;
    gallery.classList.remove('flex');
    document.body.style.overflow = '';
    if (lastFocused) lastFocused.focus();
  };

  const goTo = (index: number): void => {
    current = clamp(index);
    render();
  };

  if (gallery) {
    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-lightbox-trigger]');
      if (!trigger) return;
      images = parseImages(trigger.getAttribute('data-lightbox-images'));
      if (images.length === 0) return;
      current = 0;
      show();
    });

    closeBtn?.addEventListener('click', hide);

    gallery.addEventListener('click', (event) => {
      if (event.target === gallery) hide();
    });

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));

    document.addEventListener('keydown', (event) => {
      if (gallery.hidden) return;
      if (event.key === 'Escape') {
        hide();
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(current - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(current + 1);
      }
    });
  }
</script>
