---
import type { Project } from '../../types/molecules';
import ProjectCard from './ProjectCard.astro';

interface Props {
  title: string;
  items: Project[];
  codeLabel?: string;
  demoLabel?: string;
  photosLabel?: string;
  direction?: 'left' | 'right';
}

const {
  title,
  items,
  codeLabel = 'Code',
  demoLabel = 'Demo',
  photosLabel = 'Photos',
  direction = 'left',
} = Astro.props;

// Duplicate items so the marquee loop is seamless.
const loopItems = [...items, ...items];
---

<div class="project-carousel w-full" data-direction={direction}>
  <div class="mb-2 flex items-center justify-between">
    <h3 class="font-medium text-lg md:text-xl tracking-tight text-gray-900 dark:text-white">{title}</h3>
  </div>

  <div class="carousel-viewport overflow-hidden">
    <div class="carousel-track flex gap-3" data-carousel-track>
      {loopItems.map((item, index) => (
        <div class="w-[280px] flex-none md:w-[300px]">
          <ProjectCard
            title={item.title}
            description={item.description}
            tags={item.tags}
            github={item.github}
            link={item.link}
            image={item.image}
            images={item.images}
            index={index % items.length}
            codeLabel={codeLabel}
            demoLabel={demoLabel}
            photosLabel={photosLabel}
          />
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  /* Barber-shop marquee: the whole row drifts in one direction. Each
     carousel instance picks its direction via the data-direction attr
     (odd rows right, even rows left). Duplicated items + translateX(-50%)
     make the loop seamless. Pauses on hover so cards stay clickable. */
  .carousel-viewport {
    mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
  }

  .carousel-track {
    width: max-content;
    animation: marquee-left 32s linear infinite;
    will-change: transform;
  }

  .project-carousel[data-direction='right'] .carousel-track {
    animation-name: marquee-right;
  }

  .project-carousel:hover .carousel-track {
    animation-play-state: paused;
  }

  @keyframes marquee-left {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @keyframes marquee-right {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      animation: none;
    }
  }
</style>