---
import type { TechTag } from '../../types/molecules';
import Button from '../atoms/Button.astro';
import Github from '../../icons/Github.astro';
import Link from '../../icons/Link.astro';
import Camera from '../../icons/Camera.astro';

interface Props {
  title: string;
  description: string;
  tags: (TechTag | string)[];
  github: string;
  link?: string;
  image: string;
  images?: string[];
  index: number;
  codeLabel?: string;
  demoLabel?: string;
  photosLabel?: string;
  class?: string;
}

const {
  title,
  description,
  tags,
  github,
  link,
  image,
  images,
  codeLabel = 'Code',
  demoLabel = 'Demo',
  photosLabel = 'Photos',
  class: className,
} = Astro.props;
const gallery = images && images.length ? images : [image];

const getBadgeClass = (tag: TechTag | string): string => {
  if (typeof tag === 'string') {
    return 'bg-gray-200 text-gray-700 dark:bg-gray-700 dark:text-gray-300';
  }
  return tag.class || 'bg-gray-200 text-gray-700 dark:bg-gray-700 dark:text-gray-300';
};

const getBadgeName = (tag: TechTag | string): string => {
  if (typeof tag === 'string') return tag;
  return tag.name;
};
---

<article
  class:list={[
    'glow-border group relative flex h-full w-full flex-col overflow-hidden rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-sm transition-shadow duration-300 hover:shadow-md',
    className,
  ]}
>
  <!-- Image area -->
  <div class="relative aspect-[4/3] w-full shrink-0 overflow-hidden rounded-t-xl">
    <img
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      src={image}
      alt={`Screenshot of ${title}`}
      loading="lazy"
    />
  </div>

  <!-- Body -->
  <div class="relative z-10 flex min-h-0 flex-1 flex-col justify-between px-3 pt-3 pb-2">
    <div class="min-h-0 flex-1">
      <h3 class="font-medium text-sm tracking-tight text-gray-900 dark:text-white">{title}</h3>
      <ul class="mt-1.5 flex flex-wrap gap-1 list-none p-0 m-0">
        {tags.map((tag) => (
          <li>
            <span
              class:list={[
                'inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium',
                getBadgeClass(tag),
              ]}
            >
              {getBadgeName(tag)}
            </span>
          </li>
        ))}
      </ul>
      <p class="mt-1.5 text-xs leading-relaxed text-gray-600 dark:text-gray-300 text-pretty">{description}</p>
    </div>

    <footer class="mt-3 flex flex-wrap items-center gap-1.5 pt-2">
      {github && github !== '#' && (
        <Button
          href={github}
          class="!py-1 !px-2 text-xs hover:-translate-y-0.5 hover:bg-sky-600 hover:border-sky-500 hover:shadow-md hover:shadow-sky-500/40 active:translate-y-0"
        >
          <Github class="size-3.5" />
          {codeLabel}
        </Button>
      )}
      {link && (
        <Button
          href={link}
          variant="secondary"
          target="_blank"
          rel="noopener noreferrer"
          class="!py-1 !px-2 text-xs hover:-translate-y-0.5 hover:border-sky-500 hover:bg-sky-50 hover:text-sky-700 hover:shadow-md hover:shadow-sky-500/25 active:translate-y-0 dark:hover:bg-sky-500/10 dark:hover:text-sky-300"
        >
          <Link class="size-3.5" />
          {demoLabel}
        </Button>
      )}
      <button
        type="button"
        data-lightbox-trigger
        data-lightbox-images={JSON.stringify(gallery)}
        aria-label={`Open image gallery for ${title}`}
        class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-gray-600 px-2 py-1 text-xs text-gray-800 transition hover:-translate-y-0.5 hover:border-sky-500 hover:bg-sky-50 hover:text-sky-700 hover:shadow-md hover:shadow-sky-500/25 active:translate-y-0 dark:text-white dark:hover:bg-sky-500/10 dark:hover:text-sky-300"
      >
        <Camera class="size-3.5" />
        {photosLabel}
      </button>
    </footer>
  </div>
</article>

<style>
  /*
    Glowing border (cursor-tracking):
    - ::before = soft radial light bloom that follows the pointer, behind content.
    - ::after  = 1.5px radial-gradient ring masked to the border area that
      brightens near the cursor. Both stay hidden until hover, and the whole
      effect is skipped under prefers-reduced-motion.
  */
  .glow-border {
    --glow-x: 50%;
    --glow-y: 50%;
    isolation: isolate;
    border-radius: 0.75rem;
  }

  .glow-border::before {
    content: '';
    position: absolute;
    z-index: 0;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      340px circle at var(--glow-x) var(--glow-y),
      rgba(56, 189, 248, 0.16),
      rgba(129, 140, 248, 0.06) 45%,
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .glow-border::after {
    content: '';
    position: absolute;
    z-index: 20;
    inset: 0;
    border-radius: inherit;
    padding: 1.5px;
    background: radial-gradient(
      300px circle at var(--glow-x) var(--glow-y),
      #38bdf8,
      #818cf8 45%,
      transparent 65%
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .glow-border:hover::before,
    .glow-border:hover::after {
      opacity: 1;
    }
  }
</style>

<script>
  // Cursor-tracking glow: write pointer position into --glow-x/--glow-y,
  // used by the radial glow layers above. Skipped for reduced motion and
  // touch-only devices (the CSS :hover rule gates visibility anyway).
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    document.querySelectorAll<HTMLElement>('.glow-border').forEach((card) => {
      card.addEventListener('mousemove', (event) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--glow-x', `${event.clientX - rect.left}px`);
        card.style.setProperty('--glow-y', `${event.clientY - rect.top}px`);
      });
    });
  }
</script>
